#!/usr/bin/env python3

import sys
import os
import argparse
import json
from aio_pika import Message
rootdir = os.path.abspath(os.path.join(os.path.dirname(__file__), os.pardir))
sys.path.append(rootdir)
from robotjessrv import config

# get commandline arguments
parser = argparse.ArgumentParser(description='Start the Bubbles/Robo REST Server.')
parser.add_argument('--host', type=str, default='localhost', help='host')
parser.add_argument('--port', type=int, default=8765, help='port')
parser.add_argument('--pikaurl', type=str, default=config.PIKA_URL, help='rabbitmq url')

parser.add_argument('--logconf', type=str, default=config.LOG_CONFIG_FILE, help='port')
parser.add_argument('--bubblehubsexchange', type=str, default=config.BUBBLEHUBS_EXCHANGE, help='rabbitmq queue to use for rpc calls')
parser.add_argument('--bubblehubsqueue', type=str, default=config.BUBBLEHUBS_QUEUE, help='rabbitmq queue to use for rpc calls')
parser.add_argument('--monitorexchange', type=str, default=config.MONITOR_EXCHANGE, help='monitor exchange')
parser.add_argument('--gamesexchange', type=str, default=config.GAMES_EXCHANGE, help='games exchange')
args = parser.parse_args()

# import robotjessrv.server
# import robotjessrv.client
import robotjessrv.server.roborest as roborest
import robotjessrv.server.monitor as monitor
# initialise
roborest.pikaurl = args.pikaurl

monitor.mon = monitor.async_monitor_client.AsyncMonitorClient(args.monitorexchange)

from robotjes.server.status_keeper import StatusKeeper


async def listener(routing_key, request):
    # a game status has been received. Let the status_keeper store it.
    # capture all the (synchronous) events from the status_keeper and handle them afterwards
    events = roborest.status_keeper.game_status_event(request)
    for event in events:
        if "msg" in event:
            if event["msg"] in ["PLAYER_REGISTER","PLAYER_DEREGISTER","PLAYER_SUCCESS","PLAYER_FAILURE"]:
                body = json.dumps(event, default=str)
                message = Message(body.encode(), content_type="application/json")
                await roborest.field_exchange.publish(message, routing_key="")


async def field_listener(routing_key, request):
    # received an UUID from the Field interface in Robomind Academy. Remember it and its data
    # and use it to recognise a registering user/solution. When the solution is done the
    # success/failure will be send back to Robomind Academy.
    if routing_key == 'activate.field':
        try:
            # register the reservation UUID
            uuid = request.get('uuid', None)
            game_name = request.get('game_name', None)
            player_name = request.get('player_name', None)
            password = request.get('password', None)
            if uuid and game_name:
                roborest.status_keeper.set_reservation(uuid, game_name, player_name, password)
        except Exception as e:
            print(f"huh: {e}")

roborest.status_keeper = StatusKeeper()

# initialise the roborest module
import fastapi

from robotjessrv.server.roborest.async_rpc_client import AsyncRPCClient
roborest.async_rpc_client = AsyncRPCClient(args.bubblehubsexchange, args.bubblehubsqueue)

from robotjessrv.server.roborest.async_topic_listener import AsyncTopicListener
roborest.async_topic_listener = AsyncTopicListener(args.gamesexchange, "*.status", listener)
roborest.async_field_listener = AsyncTopicListener(args.gamesexchange, "*.field", field_listener)
roborest.app = fastapi.FastAPI()

# import the files with REST calls (do not remove!!!)
import robotjessrv.server.roborest.sys_rest
import robotjessrv.server.roborest.bubble_hub_rest
import robotjessrv.server.roborest.game_rest


# do static files support
from fastapi.staticfiles import StaticFiles
roborest.app.mount("/", StaticFiles(directory=os.path.join(rootdir, "www")), name="www")

# start the webserver (note the logging configuration)
import uvicorn
uvicorn.run(roborest.app, host=args.host, port=args.port, log_config=args.logconf)
print("done")
